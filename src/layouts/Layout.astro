---
import "../styles/global.css";
import BaseHead from "./BaseHead.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";

export interface Props {
	title?: string;
	description?: string;
	publishedDate?: string;
	authors?: string[];
	tags?: string;
}

const { title, description, publishedDate, authors, tags } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} publishedDate={publishedDate} authors={authors} tags={tags} />
	</head>
	<body class="font-mono min-h-screen flex flex-col bg-white dark:bg-slate-900 text-gray-900 dark:text-gray-100 transition-colors duration-300">
		<Header />
		<main class="flex-1 pt-20">
			<slot />
		</main>
		<Footer />
	</body>
</html>
