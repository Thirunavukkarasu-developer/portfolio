---
import Layout from "../layouts/Layout.astro";

const title = "Resume | Thiruna";
const description = "View and download my professional resume. Senior Full Stack Developer with expertise in React, Node.js, and TypeScript.";
---

<Layout title={title} description={description}>
    <section
        id="my-resume"
        class="max-w-5xl mx-auto px-5 sm:px-6 lg:px-8 py-10 overflow-x-hidden"
    >
        <!-- Header -->
        <div class="mb-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4 animate-fade-in-up">
            <div>
                <h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-2">
                    My <span class="gradient-text">Resume</span>
                </h1>
                <p class="text-gray-600 dark:text-gray-400">
                    Senior Full Stack Developer • 5+ years of experience
                </p>
            </div>
            <a
                href="/Thirunavukkarasu_E.pdf"
                download="Thirunavukkarasu_E_Resume.pdf"
                class="btn-primary inline-flex items-center gap-2 self-start md:self-auto"
            >
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                Download PDF
            </a>
        </div>

        <!-- Quick Stats -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8 animate-fade-in-up delay-100">
            <div class="p-4 rounded-xl bg-white dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700 text-center">
                <p class="text-2xl md:text-3xl font-bold text-blue-600 dark:text-blue-400">5+</p>
                <p class="text-sm text-gray-600 dark:text-gray-400">Years Experience</p>
            </div>
            <div class="p-4 rounded-xl bg-white dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700 text-center">
                <p class="text-2xl md:text-3xl font-bold text-blue-600 dark:text-blue-400">20+</p>
                <p class="text-sm text-gray-600 dark:text-gray-400">Projects Delivered</p>
            </div>
            <div class="p-4 rounded-xl bg-white dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700 text-center">
                <p class="text-2xl md:text-3xl font-bold text-blue-600 dark:text-blue-400">10+</p>
                <p class="text-sm text-gray-600 dark:text-gray-400">Technologies</p>
            </div>
            <div class="p-4 rounded-xl bg-white dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700 text-center">
                <p class="text-2xl md:text-3xl font-bold text-blue-600 dark:text-blue-400">100%</p>
                <p class="text-sm text-gray-600 dark:text-gray-400">Remote Ready</p>
            </div>
        </div>

        <!-- Skills Section -->
        <div class="mb-8 animate-fade-in-up delay-200">
            <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Core Skills</h2>
            <div class="flex flex-wrap gap-2">
                {['React', 'React Native', 'Node.js', 'TypeScript', 'JavaScript', 'Angular', 'Next.js', 'Express.js', 'MongoDB', 'PostgreSQL', 'MySQL', 'TailwindCSS', 'Material UI', 'Git', 'Docker', 'AWS'].map((skill) => (
                    <span class="px-4 py-2 text-sm font-medium bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-blue-50 dark:hover:bg-blue-900/30 hover:text-blue-600 dark:hover:text-blue-400 transition-all duration-300">
                        {skill}
                    </span>
                ))}
            </div>
        </div>

        <!-- PDF Viewer -->
        <div class="rounded-xl overflow-hidden border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 shadow-lg animate-fade-in-up delay-300">
            <div class="bg-gray-100 dark:bg-gray-700 px-4 py-3 flex items-center justify-between border-b border-gray-200 dark:border-gray-600">
                <div class="flex items-center gap-2">
                    <svg class="w-5 h-5 text-red-500" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm-1 2l5 5h-5V4zM8.5 13H10v5H8.5v-5zm3 0h1.5v5H11.5v-5zm3 0h1.5v3.5h-1v1.5h-1.5v-5h1v-.5z"/>
                    </svg>
                    <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Thirunavukkarasu_E_Resume.pdf</span>
                </div>
                <a 
                    href="/Thirunavukkarasu_E.pdf"
                    target="_blank"
                    class="text-sm text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 font-medium flex items-center gap-1"
                >
                    Open in new tab
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                </a>
            </div>
            <iframe
                src="/Thirunavukkarasu_E.pdf#navpanes=0&toolbar=0"
                width="100%"
                height="800"
                class="border-0"
                title="Resume Preview"
            ></iframe>
        </div>

        <!-- Contact CTA -->
        <div class="mt-10 text-center animate-fade-in-up delay-400">
            <p class="text-gray-600 dark:text-gray-400 mb-4">
                Interested in working together?
            </p>
            <a 
                href="/contact"
                class="inline-flex items-center gap-2 text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 font-medium transition-colors"
            >
                Get in touch
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
            </a>
        </div>
    </section>
</Layout>
